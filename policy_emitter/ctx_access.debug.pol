  && (4 <= off && off + size <= 8 -> dst : INT)
  && (12 <= off && off + size <= 16 -> dst : INT)
  && (16 <= off && off + size <= 20 -> dst : INT)
  && (20 <= off && off + size <= 24 -> dst : INT)
  && (24 <= off && off + size <= 28 -> dst : INT)
  && (28 <= off && off + size <= 32 -> dst : INT)
  && (32 <= off && off + size <= 36 -> dst : INT)
  && (36 <= off && off + size <= 40 -> dst : INT)
  && (40 <= off && off + size <= 44 -> dst : INT)
  && (44 <= off && off + size <= 48 -> dst : INT)
  && (48 <= off && off + size <= 68 -> dst : INT)
  && (68 <= off && off + size <= 72 -> dst : INT)
  && (76 <= off && off + size <= 80 -> dst : PTR_TO_PACKET && dst.offset = 0)
  && (80 <= off && off + size <= 84 -> dst : PTR_TO_PACKET_END && dst.offset = 0)
  && (84 <= off && off + size <= 88 -> dst : INT)
  && (88 <= off && off + size <= 92 -> dst : INT)
  && (92 <= off && off + size <= 96 -> dst : INT)
  && (96 <= off && off + size <= 100 -> dst : INT)
  && (100 <= off && off + size <= 116 -> dst : INT)
  && (116 <= off && off + size <= 132 -> dst : INT)
  && (132 <= off && off + size <= 136 -> dst : INT)
  && (136 <= off && off + size <= 140 -> dst : INT)
  && (164 <= off && off + size <= 168 -> dst : INT)
  && (168 <= off && off + size <= 176 -> dst : PTR_TO_SOCK_COMMON_OR_NULL && dst.offset = 0)
  && (176 <= off && off + size <= 180 -> dst : INT);

sk_msg_ctx_read_access(off, size) :=
  off % size = 0
  && (
    0 <= off && off + size <= 8 && size = 8
    || 8 <= off && off + size <= 16 && size = 8
    || 16 <= off && off + size <= 20 && size = 4
    || 20 <= off && off + size <= 24 && size = 4
    || 24 <= off && off + size <= 28 && size = 4
    || 28 <= off && off + size <= 44 && size = 4
    || 44 <= off && off + size <= 60 && size = 4
    || 60 <= off && off + size <= 64 && size = 4
    || 64 <= off && off + size <= 68 && size = 4
    || 68 <= off && off + size <= 72 && size = 4
    || 72 <= off && off + size <= 80 && size = 8
  );

sk_msg_ctx_write_access(off, size) :=
  off % size = 0
  && (
    0 <= off && off + size <= 8 && false
    || 8 <= off && off + size <= 16 && false
    || 16 <= off && off + size <= 20 && false
    || 20 <= off && off + size <= 24 && false
    || 24 <= off && off + size <= 28 && false
    || 28 <= off && off + size <= 44 && false
    || 44 <= off && off + size <= 60 && false
    || 60 <= off && off + size <= 64 && false
    || 64 <= off && off + size <= 68 && false
    || 68 <= off && off + size <= 72 && false
    || 72 <= off && off + size <= 80 && false
  );

sk_msg_ctx_read_type(dst, off, size) :=
  (0 <= off && off + size <= 8 -> dst : PTR_TO_PACKET && dst.offset = 0)
  && (8 <= off && off + size <= 16 -> dst : PTR_TO_PACKET_END && dst.offset = 0)
  && (16 <= off && off + size <= 20 -> dst : INT)
  && (20 <= off && off + size <= 24 -> dst : INT)
  && (24 <= off && off + size <= 28 -> dst : INT)
  && (28 <= off && off + size <= 44 -> dst : INT)
  && (44 <= off && off + size <= 60 -> dst : INT)
  && (60 <= off && off + size <= 64 -> dst : INT)
  && (64 <= off && off + size <= 68 -> dst : INT)
  && (68 <= off && off + size <= 72 -> dst : INT)
  && (72 <= off && off + size <= 80 -> dst : PTR_TO_SOCKET && dst.offset = 0);

flow_dissector_ctx_read_access(off, size) :=
  off % size = 0
  && (
    76 <= off && off + size <= 80 && size = 4
    || 80 <= off && off + size <= 84 && size = 4
    || 144 <= off && off + size <= 152 && size = 8
  );

flow_dissector_ctx_write_access(off, size) :=
  off % size = 0
  && (
    76 <= off && off + size <= 80 && false
    || 80 <= off && off + size <= 84 && false
    || 144 <= off && off + size <= 152 && false
  );

flow_dissector_ctx_read_type(dst, off, size) :=
  (76 <= off && off + size <= 80 -> dst : PTR_TO_PACKET && dst.offset = 0)
  && (80 <= off && off + size <= 84 -> dst : PTR_TO_PACKET_END && dst.offset = 0)
  && (144 <= off && off + size <= 152 -> dst : PTR_TO_FLOW_KEYS && dst.offset = 0);

cgroup_sock_ctx_read_access(off, size) :=
  off % size = 0
  && (
    0 <= off
      && off + size <= 4
      && (size = 4 && (ATTACH_TYPE = BPF_CGROUP_INET_SOCK_CREATE || ATTACH_TYPE = BPF_CGROUP_INET_SOCK_RELEASE))
    || 4 <= off && off + size <= 8 && off = 4 && (size = 1 || size = 2 || size = 4)
    || 8 <= off && off + size <= 12 && off = 8 && (size = 1 || size = 2 || size = 4)
    || 12 <= off && off + size <= 16 && off = 12 && (size = 1 || size = 2 || size = 4)
    || 16 <= off
      && off + size <= 20
      && (size = 4 && (ATTACH_TYPE = BPF_CGROUP_INET_SOCK_CREATE || ATTACH_TYPE = BPF_CGROUP_INET_SOCK_RELEASE))
    || 20 <= off
      && off + size <= 24
      && (size = 4 && (ATTACH_TYPE = BPF_CGROUP_INET_SOCK_CREATE || ATTACH_TYPE = BPF_CGROUP_INET_SOCK_RELEASE))
    || 24 <= off && off + size <= 28 && ((size = 1 || size = 2 || size = 4) && ATTACH_TYPE = BPF_CGROUP_INET4_POST_BIND)
    || 28 <= off && off + size <= 44 && ((size = 1 || size = 2 || size = 4) && ATTACH_TYPE = BPF_CGROUP_INET6_POST_BIND)
    || 44 <= off
      && off + size <= 48
      && off = 44
      && (
        (size = 1 || size = 2 || size = 4)
        && (ATTACH_TYPE = BPF_CGROUP_INET4_POST_BIND || ATTACH_TYPE = BPF_CGROUP_INET6_POST_BIND)
      )
    || 48 <= off && off + size <= 50 && (size = 1 || size = 2)
    || 48 <= off && off + size <= 52 && size = 4
    || 52 <= off && off + size <= 56 && (size = 1 || size = 2 || size = 4)
    || 56 <= off && off + size <= 72 && (size = 1 || size = 2 || size = 4)
    || 72 <= off && off + size <= 76 && off = 72 && (size = 1 || size = 2 || size = 4)
    || 76 <= off && off + size <= 80 && off = 76 && (size = 1 || size = 2 || size = 4)
  );

cgroup_sock_ctx_write_access(off, size) :=
  off % size = 0
  && (
    0 <= off
      && off + size <= 4
      && (size = 4 && (ATTACH_TYPE = BPF_CGROUP_INET_SOCK_CREATE || ATTACH_TYPE = BPF_CGROUP_INET_SOCK_RELEASE))
    || 4 <= off && off + size <= 8 && off = 4 && false
    || 8 <= off && off + size <= 12 && off = 8 && false
    || 12 <= off && off + size <= 16 && off = 12 && false
    || 16 <= off
      && off + size <= 20
      && (size = 4 && (ATTACH_TYPE = BPF_CGROUP_INET_SOCK_CREATE || ATTACH_TYPE = BPF_CGROUP_INET_SOCK_RELEASE))
    || 20 <= off
      && off + size <= 24
      && (size = 4 && (ATTACH_TYPE = BPF_CGROUP_INET_SOCK_CREATE || ATTACH_TYPE = BPF_CGROUP_INET_SOCK_RELEASE))
    || 24 <= off && off + size <= 28 && false
    || 28 <= off && off + size <= 44 && false
    || 44 <= off && off + size <= 48 && off = 44 && false
    || 48 <= off && off + size <= 50 && false
    || 48 <= off && off + size <= 52 && false
    || 52 <= off && off + size <= 56 && false
    || 56 <= off && off + size <= 72 && false
    || 72 <= off && off + size <= 76 && off = 72 && false
    || 76 <= off && off + size <= 80 && off = 76 && false
  );

cgroup_sock_ctx_read_type(dst, off, size) :=
  (0 <= off && off + size <= 4 -> dst : INT)
  && (4 <= off && off + size <= 8 -> dst : INT)
  && (8 <= off && off + size <= 12 -> dst : INT)
  && (12 <= off && off + size <= 16 -> dst : INT)
  && (16 <= off && off + size <= 20 -> dst : INT)
  && (20 <= off && off + size <= 24 -> dst : INT)
  && (24 <= off && off + size <= 28 -> dst : INT)
  && (28 <= off && off + size <= 44 -> dst : INT)
  && (44 <= off && off + size <= 48 -> dst : INT)
  && (48 <= off && off + size <= 50 -> dst : INT)
  && (48 <= off && off + size <= 52 -> dst : INT)
  && (52 <= off && off + size <= 56 -> dst : INT)
  && (56 <= off && off + size <= 72 -> dst : INT)
  && (72 <= off && off + size <= 76 -> dst : INT)
  && (76 <= off && off + size <= 80 -> dst : INT);

cgroup_sock_addr_ctx_read_access(off, size) :=
  off % size = 0
  && (
    0 <= off && off + size <= 4 && size = 4
    || 4 <= off
      && off + size <= 8
      && (
        (size = 1 || size = 2 || size = 4)
        && (
          ATTACH_TYPE = BPF_CGROUP_INET4_BIND
          || ATTACH_TYPE = BPF_CGROUP_INET4_CONNECT
          || ATTACH_TYPE = BPF_CGROUP_INET4_GETPEERNAME
          || ATTACH_TYPE = BPF_CGROUP_INET4_GETSOCKNAME
          || ATTACH_TYPE = BPF_CGROUP_UDP4_SENDMSG
          || ATTACH_TYPE = BPF_CGROUP_UDP4_RECVMSG
        )
      )
    || 8 <= off
      && off + size <= 24
      && (
        (size = 1 || size = 2 || size = 4 || size = 8)
        && (
          ATTACH_TYPE = BPF_CGROUP_INET6_BIND
          || ATTACH_TYPE = BPF_CGROUP_INET6_CONNECT
          || ATTACH_TYPE = BPF_CGROUP_INET6_GETPEERNAME
          || ATTACH_TYPE = BPF_CGROUP_INET6_GETSOCKNAME
          || ATTACH_TYPE = BPF_CGROUP_UDP6_SENDMSG
          || ATTACH_TYPE = BPF_CGROUP_UDP6_RECVMSG
        )
      )
    || 24 <= off && off + size <= 28 && (size = 1 || size = 2 || size = 4)
    || 28 <= off && off + size <= 32 && size = 4
    || 32 <= off && off + size <= 36 && size = 4
    || 36 <= off && off + size <= 40 && size = 4
    || 40 <= off && off + size <= 44 && ((size = 1 || size = 2 || size = 4) && ATTACH_TYPE = BPF_CGROUP_UDP4_SENDMSG)
    || 44 <= off
      && off + size <= 60
      && ((size = 1 || size = 2 || size = 4 || size = 8) && ATTACH_TYPE = BPF_CGROUP_UDP6_SENDMSG)
    || 64 <= off && off + size <= 72 && size = 8
  );

cgroup_sock_addr_ctx_write_access(off, size) :=
  off % size = 0
  && (
    0 <= off && off + size <= 4 && false
    || 4 <= off
      && off + size <= 8
      && (
        size = 4
        && (
          ATTACH_TYPE = BPF_CGROUP_INET4_BIND
          || ATTACH_TYPE = BPF_CGROUP_INET4_CONNECT
          || ATTACH_TYPE = BPF_CGROUP_INET4_GETPEERNAME
          || ATTACH_TYPE = BPF_CGROUP_INET4_GETSOCKNAME
          || ATTACH_TYPE = BPF_CGROUP_UDP4_SENDMSG
          || ATTACH_TYPE = BPF_CGROUP_UDP4_RECVMSG
        )
      )
    || 8 <= off
      && off + size <= 24
      && (
        (size = 4 || size = 8)
        && (
          ATTACH_TYPE = BPF_CGROUP_INET6_BIND
          || ATTACH_TYPE = BPF_CGROUP_INET6_CONNECT
          || ATTACH_TYPE = BPF_CGROUP_INET6_GETPEERNAME
          || ATTACH_TYPE = BPF_CGROUP_INET6_GETSOCKNAME
          || ATTACH_TYPE = BPF_CGROUP_UDP6_SENDMSG
          || ATTACH_TYPE = BPF_CGROUP_UDP6_RECVMSG
        )
      )
    || 24 <= off && off + size <= 28 && size = 4
    || 28 <= off && off + size <= 32 && false
    || 32 <= off && off + size <= 36 && false
    || 36 <= off && off + size <= 40 && false
    || 40 <= off && off + size <= 44 && (size = 4 && ATTACH_TYPE = BPF_CGROUP_UDP4_SENDMSG)
    || 44 <= off && off + size <= 60 && ((size = 4 || size = 8) && ATTACH_TYPE = BPF_CGROUP_UDP6_SENDMSG)
    || 64 <= off && off + size <= 72 && false
  );

cgroup_sock_addr_ctx_read_type(dst, off, size) :=
  (0 <= off && off + size <= 4 -> dst : INT)
  && (4 <= off && off + size <= 8 -> dst : INT)
  && (8 <= off && off + size <= 24 -> dst : INT)
  && (24 <= off && off + size <= 28 -> dst : INT)
  && (28 <= off && off + size <= 32 -> dst : INT)
  && (32 <= off && off + size <= 36 -> dst : INT)
  && (36 <= off && off + size <= 40 -> dst : INT)
  && (40 <= off && off + size <= 44 -> dst : INT)
  && (44 <= off && off + size <= 60 -> dst : INT)
  && (64 <= off && off + size <= 72 -> dst : PTR_TO_SOCKET && dst.offset = 0);

sk_reuseport_ctx_read_access(off, size) :=
  off % size = 0
  && (
    0 <= off && off + size <= 8 && size = 8
    || 8 <= off && off + size <= 16 && size = 8
    || 16 <= off && off + size <= 20 && (size = 1 || size = 2 || size = 4)
    || 20 <= off && off + size <= 24 && (size = 2 || size = 4)
    || 24 <= off && off + size <= 28 && (size = 1 || size = 2 || size = 4)
    || 28 <= off && off + size <= 32 && (size = 1 || size = 2 || size = 4)
    || 32 <= off && off + size <= 36 && size = 4
    || 40 <= off && off + size <= 48 && size = 8
    || 48 <= off && off + size <= 56 && size = 8
  );

sk_reuseport_ctx_write_access(off, size) :=
  off % size = 0
  && (
    0 <= off && off + size <= 8 && false
    || 8 <= off && off + size <= 16 && false
    || 16 <= off && off + size <= 20 && false
    || 20 <= off && off + size <= 24 && false
    || 24 <= off && off + size <= 28 && false
    || 28 <= off && off + size <= 32 && false
    || 32 <= off && off + size <= 36 && false
    || 40 <= off && off + size <= 48 && false
    || 48 <= off && off + size <= 56 && false
  );

sk_reuseport_ctx_read_type(dst, off, size) :=
  (0 <= off && off + size <= 8 -> dst : PTR_TO_PACKET && dst.offset = 0)
  && (8 <= off && off + size <= 16 -> dst : PTR_TO_PACKET_END && dst.offset = 0)
  && (16 <= off && off + size <= 20 -> dst : INT)
  && (20 <= off && off + size <= 24 -> dst : INT)
  && (24 <= off && off + size <= 28 -> dst : INT)
  && (28 <= off && off + size <= 32 -> dst : INT)
  && (32 <= off && off + size <= 36 -> dst : INT)
  && (40 <= off && off + size <= 48 -> dst : PTR_TO_SOCKET && dst.offset = 0)
  && (48 <= off && off + size <= 56 -> dst : PTR_TO_SOCK_COMMON_OR_NULL && dst.offset = 0);

sk_lookup_ctx_read_access(off, size) :=
  off % size = 0
  && (
    0 <= off && off + size <= 8 && size = 8
    || 8 <= off && off + size <= 12 && (size = 1 || size = 2 || size = 4)
    || 12 <= off && off + size <= 16 && (size = 1 || size = 2 || size = 4)
    || 16 <= off && off + size <= 20 && (size = 1 || size = 2 || size = 4)
    || 20 <= off && off + size <= 36 && (size = 1 || size = 2 || size = 4)
    || 36 <= off && off + size <= 40 && (size = 1 || size = 2 || size = 4)
    || 40 <= off && off + size <= 44 && (size = 1 || size = 2 || size = 4)
    || 44 <= off && off + size <= 60 && (size = 1 || size = 2 || size = 4)
    || 60 <= off && off + size <= 64 && (size = 1 || size = 2 || size = 4)
    || 64 <= off && off + size <= 68 && (size = 1 || size = 2 || size = 4)
  );

sk_lookup_ctx_write_access(off, size) :=
  off % size = 0
  && (
    0 <= off && off + size <= 8 && false
    || 8 <= off && off + size <= 12 && false
    || 12 <= off && off + size <= 16 && false
    || 16 <= off && off + size <= 20 && false
    || 20 <= off && off + size <= 36 && false
    || 36 <= off && off + size <= 40 && false
    || 40 <= off && off + size <= 44 && false
    || 44 <= off && off + size <= 60 && false
    || 60 <= off && off + size <= 64 && false
    || 64 <= off && off + size <= 68 && false
  );

sk_lookup_ctx_read_type(dst, off, size) :=
  (0 <= off && off + size <= 8 -> dst : PTR_TO_SOCKET_OR_NULL && dst.offset = 0)
  && (8 <= off && off + size <= 12 -> dst : INT)
  && (12 <= off && off + size <= 16 -> dst : INT)
  && (16 <= off && off + size <= 20 -> dst : INT)
  && (20 <= off && off + size <= 36 -> dst : INT)
  && (36 <= off && off + size <= 40 -> dst : INT)
  && (40 <= off && off + size <= 44 -> dst : INT)
  && (44 <= off && off + size <= 60 -> dst : INT)
  && (60 <= off && off + size <= 64 -> dst : INT)
  && (64 <= off && off + size <= 68 -> dst : INT);

cgroup_sockopt_ctx_read_access(off, size) :=
  off % size = 0
  && (
    0 <= off && off + size <= 8 && size = 8
    || 8 <= off && off + size <= 16 && size = 8
    || 16 <= off && off + size <= 24 && size = 8
    || 24 <= off && off + size <= 28 && size = 4
    || 28 <= off && off + size <= 32 && size = 4
    || 32 <= off && off + size <= 36 && size = 4
    || 36 <= off && off + size <= 40 && (size = 4 && ATTACH_TYPE = BPF_CGROUP_GETSOCKOPT)
  );

cgroup_sockopt_ctx_write_access(off, size) :=
  off % size = 0
  && (
    0 <= off && off + size <= 8 && false
    || 8 <= off && off + size <= 16 && false
    || 16 <= off && off + size <= 24 && false
    || 24 <= off && off + size <= 28 && (size = 4 && ATTACH_TYPE = BPF_CGROUP_SETSOCKOPT)
    || 28 <= off && off + size <= 32 && (size = 4 && ATTACH_TYPE = BPF_CGROUP_SETSOCKOPT)
    || 32 <= off && off + size <= 36 && size = 4
    || 36 <= off && off + size <= 40 && (size = 4 && ATTACH_TYPE = BPF_CGROUP_GETSOCKOPT)
  );

cgroup_sockopt_ctx_read_type(dst, off, size) :=
  (0 <= off && off + size <= 8 -> dst : PTR_TO_SOCKET && dst.offset = 0)
  && (8 <= off && off + size <= 16 -> dst : PTR_TO_PACKET && dst.offset = 0)
  && (16 <= off && off + size <= 24 -> dst : PTR_TO_PACKET_END && dst.offset = 0)
  && (24 <= off && off + size <= 28 -> dst : INT)
  && (28 <= off && off + size <= 32 -> dst : INT)
  && (32 <= off && off + size <= 36 -> dst : INT)
  && (36 <= off && off + size <= 40 -> dst : INT);

cgroup_sysctl_ctx_read_access(off, size) :=
  off % size = 0
  && (
    0 <= off && off + size <= 4 && (size = 1 || size = 2 || size = 4)
    || 4 <= off && off + size <= 8 && (size = 1 || size = 2 || size = 4)
  );

cgroup_sysctl_ctx_write_access(off, size) :=
  off % size = 0 && (0 <= off && off + size <= 4 && false || 4 <= off && off + size <= 8 && size = 4);

cgroup_sysctl_ctx_read_type(dst, off, size) :=
  (0 <= off && off + size <= 4 -> dst : INT) && (4 <= off && off + size <= 8 -> dst : INT);

cgroup_device_ctx_read_access(off, size) :=
  off % size = 0
  && (
    0 <= off && off + size <= 4 && (size = 1 || size = 2 || size = 4)
    || 4 <= off && off + size <= 8 && size = 4
    || 8 <= off && off + size <= 12 && size = 4
  );

cgroup_device_ctx_write_access(off, size) :=
  off % size = 0
  && (
    0 <= off && off + size <= 4 && false
    || 4 <= off && off + size <= 8 && false
    || 8 <= off && off + size <= 12 && false
  );

cgroup_device_ctx_read_type(dst, off, size) :=
  (0 <= off && off + size <= 4 -> dst : INT)
  && (4 <= off && off + size <= 8 -> dst : INT)
  && (8 <= off && off + size <= 12 -> dst : INT);

lirc_mode2_ctx_read_access(off, size) := off % size = 0 && (0 <= off && off + size <= 4 && size = 4);

lirc_mode2_ctx_write_access(off, size) := off % size = 0 && (0 <= off && off + size <= 4 && false);

lirc_mode2_ctx_read_type(dst, off, size) := 0 <= off && off + size <= 4 -> dst : INT;

raw_tracepoint_ctx_read_access(off, size) :=
  off % size = 0 && (0 <= off && off + size <= 96 && (size = 1 || size = 2 || size = 4 || size = 8));

raw_tracepoint_ctx_write_access(off, size) := off % size = 0 && (0 <= off && off + size <= 96 && false);

raw_tracepoint_ctx_read_type(dst, off, size) := 0 <= off && off + size <= 96 -> dst : INT;

raw_tracepoint_writable_ctx_read_access(off, size) :=
  off % size = 0
  && (
    0 <= off && off + size <= 8 && size = 8
    || 1 <= off && off + size <= 8 && (size = 1 || size = 2 || size = 4)
    || 8 <= off && off + size <= 96 && (size = 1 || size = 2 || size = 4 || size = 8)
  );

raw_tracepoint_writable_ctx_write_access(off, size) :=
  off % size = 0
  && (
    0 <= off && off + size <= 8 && false
    || 1 <= off && off + size <= 8 && false
    || 8 <= off && off + size <= 96 && false
  );

raw_tracepoint_writable_ctx_read_type(dst, off, size) :=
  (0 <= off && off + size <= 8 -> dst : PTR_TO_TP_BUFFER && dst.offset = 0)
  && (1 <= off && off + size <= 8 -> dst : INT)
  && (8 <= off && off + size <= 96 -> dst : INT);

syscall_ctx_read_access(off, size) :=
  off % size = 0 && (0 <= off && off + size <= 65535 && (size = 1 || size = 2 || size = 4 || size = 8));

syscall_ctx_write_access(off, size) :=
  off % size = 0 && (0 <= off && off + size <= 65535 && (size = 1 || size = 2 || size = 4 || size = 8));

syscall_ctx_read_type(dst, off, size) := 0 <= off && off + size <= 65535 -> dst : INT;

netfilter_ctx_read_access(off, size) :=
  off % size = 0 && (0 <= off && off + size <= 8 && size = 8 || 8 <= off && off + size <= 16 && size = 8);

netfilter_ctx_write_access(off, size) :=
  off % size = 0 && (0 <= off && off + size <= 8 && false || 8 <= off && off + size <= 16 && false);

netfilter_ctx_read_type(dst, off, size) :=
  (0 <= off && off + size <= 8 -> dst : PTR_TO_BTF_ID_TRUSTED && dst.offset = 0 && dst.btf_id = $ctx_field_btf_id(off)$)
  && (
    8 <= off && off + size <= 16
    -> dst : PTR_TO_BTF_ID_TRUSTED && dst.offset = 0 && dst.btf_id = $ctx_field_btf_id(off)$
  );

ctx_read_access(off, size) :=
  (PROG_TYPE = BPF_PROG_TYPE_KPROBE -> kprobe_ctx_read_access(off, size))
  && (PROG_TYPE = BPF_PROG_TYPE_XDP -> xdp_ctx_read_access(off, size))
  && (PROG_TYPE = BPF_PROG_TYPE_TRACEPOINT -> tracepoint_ctx_read_access(off, size))
  && (PROG_TYPE = BPF_PROG_TYPE_TRACING -> ...)
  && (PROG_TYPE = BPF_PROG_TYPE_PERF_EVENT -> perf_event_ctx_read_access(off, size))
  && (PROG_TYPE = BPF_PROG_TYPE_SOCKET_FILTER -> socket_filter_ctx_read_access(off, size))
  && (PROG_TYPE = BPF_PROG_TYPE_SCHED_CLS -> sched_cls_ctx_read_access(off, size))
  && (PROG_TYPE = BPF_PROG_TYPE_SCHED_ACT -> sched_act_ctx_read_access(off, size))
  && (PROG_TYPE = BPF_PROG_TYPE_CGROUP_SKB -> cgroup_skb_ctx_read_access(off, size))
  && (PROG_TYPE = BPF_PROG_TYPE_LWT_IN -> lwt_in_ctx_read_access(off, size))
  && (PROG_TYPE = BPF_PROG_TYPE_LWT_OUT -> lwt_out_ctx_read_access(off, size))
  && (PROG_TYPE = BPF_PROG_TYPE_LWT_XMIT -> lwt_xmit_ctx_read_access(off, size))
  && (PROG_TYPE = BPF_PROG_TYPE_LWT_SEG6LOCAL -> lwt_seg6local_ctx_read_access(off, size))
  && (PROG_TYPE = BPF_PROG_TYPE_SOCK_OPS -> sock_ops_ctx_read_access(off, size))
  && (PROG_TYPE = BPF_PROG_TYPE_SK_SKB -> sk_skb_ctx_read_access(off, size))
  && (PROG_TYPE = BPF_PROG_TYPE_SK_MSG -> sk_msg_ctx_read_access(off, size))
