  && (PROG_TYPE = BPF_PROG_TYPE_SYSCALL -> syscall_ctx_read_access(off, size))
  && (PROG_TYPE = BPF_PROG_TYPE_NETFILTER -> netfilter_ctx_read_access(off, size))
  && (PROG_TYPE = BPF_PROG_TYPE_LSM -> ...)
  && (PROG_TYPE = BPF_PROG_TYPE_STRUCT_OPS -> ...)
  && (PROG_TYPE = BPF_PROG_TYPE_EXT -> ...);

ctx_write_access(off, size) :=
  (PROG_TYPE = BPF_PROG_TYPE_KPROBE -> kprobe_ctx_write_access(off, size))
  && (PROG_TYPE = BPF_PROG_TYPE_XDP -> xdp_ctx_write_access(off, size))
