  && (PROG_TYPE = BPF_PROG_TYPE_RAW_TRACEPOINT_WRITABLE -> raw_tracepoint_writable_ctx_write_access(off, size))
  && (PROG_TYPE = BPF_PROG_TYPE_SYSCALL -> syscall_ctx_write_access(off, size))
  && (PROG_TYPE = BPF_PROG_TYPE_NETFILTER -> netfilter_ctx_write_access(off, size))
  && (PROG_TYPE = BPF_PROG_TYPE_LSM -> ...)
  && (PROG_TYPE = BPF_PROG_TYPE_STRUCT_OPS -> ...)
  && (PROG_TYPE = BPF_PROG_TYPE_EXT -> ...);

ctx_read_type(dst, off, size) :=
