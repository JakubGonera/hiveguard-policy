  && (PROG_TYPE = BPF_PROG_TYPE_FLOW_DISSECTOR -> flow_dissector_ctx_write_access(off, size))
  && (PROG_TYPE = BPF_PROG_TYPE_CGROUP_SOCK -> cgroup_sock_ctx_write_access(off, size))
  && (PROG_TYPE = BPF_PROG_TYPE_CGROUP_SOCK_ADDR -> cgroup_sock_addr_ctx_write_access(off, size))
  && (PROG_TYPE = BPF_PROG_TYPE_SK_REUSEPORT -> sk_reuseport_ctx_write_access(off, size))
  && (PROG_TYPE = BPF_PROG_TYPE_SK_LOOKUP -> sk_lookup_ctx_write_access(off, size))
